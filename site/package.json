{
  "name": "minne-site",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun scripts/build.mjs",
    "build:svg": "bun src/make-static-svg.mjs",
    "serve": "bun scripts/build.mjs && python3 -m http.server 8765 --directory dist",
    "deploy": "bun scripts/build.mjs && npx -y wrangler@4.86.0 deploy && bun ../scripts/indexnow.mjs dist https://minne.sh"
  },
  "dependencies": {
    "@fontsource-variable/familjen-grotesk": "5.3.0",
    "@fontsource-variable/source-serif-4": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0"
  },
  "devDependencies": {
    "marked": "16.4.0"
  }
}
